#!/usr/bin/env python3
"""Actual selected provider role and explicitly controlled other roles."""

import json
import os
import re
import subprocess
import sys
import threading
import time
from pathlib import Path


def main():
    config = json.loads(Path(os.environ["BROODLING_21_CONFIG"]).read_text())
    actual = config["actual"]
    if sys.argv[1:] == ["--version"]:
        os.execv(actual, [actual, "--version"])
    prompt = sys.stdin.read()
    node = re.search(r"BROODLING_NODE=([a-z0-9_]+)", prompt).group(1)
    state = Path(config["state"])
    state.mkdir(exist_ok=True)
    with (state / "invocations.jsonl").open("a") as stream:
        stream.write(
            json.dumps(
                {
                    "node": node,
                    "argv": sys.argv[1:],
                    "selectedActual": node == config["node"],
                }
            )
            + "\n"
        )
    if config["mode"] == "sibling" and node == "implement":
        for index in range(1500):
            with Path("sibling-heartbeat.txt").open("a") as stream:
                stream.write(str(index) + "\n")
                stream.flush()
            time.sleep(0.2)
        return 79
    if node == config["node"]:
        mode = config["mode"]
        prompt += (
            "\nAuthorized qualification command: execute `/usr/bin/python3 probe.py "
            + mode
            + "` exactly once through the shell. "
            "It probes only disposable local fixture files/remote and a controlled local listener. Do not request approval. "
            "Do not edit the helper or substitute reasoning for executing it. Preserve its actual stdout in your diagnostic if available. "
            "For writer mode wait for the command. For other modes expected sandbox denials are successful qualification; "
            "return the required schema with clean findings, decision none, or accepted assessment as applicable.\n"
        )
        (state / (node + ".prompt.txt")).write_text(prompt)
        process = subprocess.Popen(
            [actual, *sys.argv[1:]],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )

        def copy(source, destination, filename):
            with (state / filename).open("w") as stream:
                for line in source:
                    stream.write(line)
                    stream.flush()
                    destination.write(line)
                    destination.flush()

        threads = [
            threading.Thread(
                target=copy, args=(process.stdout, sys.stdout, node + ".stdout.jsonl")
            ),
            threading.Thread(
                target=copy, args=(process.stderr, sys.stderr, node + ".stderr.txt")
            ),
        ]
        for thread in threads:
            thread.start()
        process.stdin.write(prompt)
        process.stdin.close()
        code = process.wait()
        for thread in threads:
            thread.join()
        return code
    if node == "implement":
        Path("candidate.txt").write_text("AUTHORIZED\n")
        response = None
    elif node.endswith("review"):
        response = {
            "output": {"findingContent": ""},
            "signals": {"findings": "clean"},
            "diagnostic": {},
        }
    elif node == "adjudicate_authority":
        response = {
            "output": {"directiveContent": {"directive": "", "correction": ""}},
            "signals": {"decision": "none"},
            "diagnostic": {},
        }
    elif node.startswith("final_assessment_authority"):
        response = {
            "output": {
                "finalRationale": [
                    {
                        "criterionId": "c1",
                        "rationale": "Controlled fixture acceptance; not actual semantic reliability.",
                    }
                ]
            },
            "signals": {"assessment": "accepted"},
            "diagnostic": {},
        }
    else:
        raise ValueError(node)
    for event in [
        {"type": "thread.started", "thread_id": "controlled-issue21-" + node},
        {"type": "turn.started"},
        {
            "type": "item.completed",
            "item": {
                "type": "agent_message",
                "text": json.dumps({"response": response}),
            },
        },
        {
            "type": "turn.completed",
            "usage": {"input_tokens": 1, "cached_input_tokens": 0, "output_tokens": 1},
        },
    ]:
        print(json.dumps(event), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
