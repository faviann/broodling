#!/usr/bin/python3
"""Controlled Codex-protocol leaf for the P1 external-boundary fixture."""

from __future__ import annotations

import hashlib
import json
import os
import re
import signal
import sys
import time
from pathlib import Path


def emit(value: dict[str, object]) -> None:
    print(json.dumps(value, separators=(",", ":")), flush=True)


def next_invocation(state: Path, node: str) -> int:
    counter = state / f"{node}.count"
    try:
        value = int(counter.read_text(encoding="utf-8")) + 1
    except FileNotFoundError:
        value = 1
    counter.write_text(f"{value}\n", encoding="utf-8")
    return value


def response_for(node: str, invocation: int, scenario: str) -> object:
    if node == "identity_check":
        label = "stale" if scenario == "q3-stale-applicability" else "applicable"
        return {"output": None, "signals": {"applicability": label}, "diagnostic": None}
    if node == "review" or node.startswith("review_"):
        repair_scenarios = {
            "repair-then-accept",
            "q3-repair-resolve",
            "q3-sticky-omission",
            "q3-final-gap-after-repair",
        }
        label = "found" if (
            scenario in repair_scenarios
            and node == "review"
            and (scenario != "repair-then-accept" or invocation == 1)
        ) else "clean"
        return {"output": None, "signals": {"findings": label}, "diagnostic": None}
    if node == "adjudicate_authority":
        if scenario == "repair-then-accept":
            label = "repair" if invocation == 1 else "advance"
            return {"output": None, "signals": {"directive": label}, "diagnostic": None}
        if scenario == "q3-contradictory-payload-signal":
            return {
                "output": {"claimedDecision": "open_d1"},
                "signals": {"decision": "none"},
                "diagnostic": None,
            }
        label = "open_d1" if scenario in {
            "q3-repair-resolve",
            "q3-sticky-omission",
            "q3-final-gap-after-repair",
        } else "none"
        return {"output": None, "signals": {"decision": label}, "diagnostic": None}
    if node == "resolution_authority" or node.startswith("resolution_authority_"):
        label = "open_d1" if scenario == "q3-sticky-omission" else "resolve_d1"
        return {"output": None, "signals": {"resolution": label}, "diagnostic": None}
    if node == "final_assessment_authority" or node.startswith("final_assessment_authority_"):
        label = "gap" if scenario in {"gap", "q3-final-gap-after-repair"} else "accepted"
        return {"output": None, "signals": {"assessment": label}, "diagnostic": None}
    return None


def scenario_parts(value: str) -> tuple[str, str, str, int | None]:
    """Return the response scenario and an optional controlled fault selector."""
    parts = value.split(";")
    response_scenario = parts[0]
    fault = parts[1] if len(parts) == 2 else parts[0]
    selected = fault.split(":")
    if len(selected) not in (2, 3) or selected[0] not in (
        "crash",
        "hang",
        "malformed",
        "missing",
        "reviewer_claim",
    ):
        return response_scenario, "", "", None
    occurrence = int(selected[2]) if len(selected) == 3 else None
    return response_scenario, selected[0], selected[1], occurrence


def main() -> int:
    prompt = sys.stdin.read()
    match = re.search(r"BROODLING_NODE=([a-z0-9_]+)", prompt)
    if match is None:
        print("fixture prompt did not identify a node", file=sys.stderr)
        return 64
    node = match.group(1)
    state = Path(os.environ["BROODLING_FIXTURE_STATE"])
    state.mkdir(parents=True, exist_ok=True)
    invocation = next_invocation(state, node)
    scenario = os.environ.get("BROODLING_FIXTURE_SCENARIO", "repair-then-accept")
    response_scenario, behavior, selected_node, selected_occurrence = scenario_parts(scenario)
    selected_here = selected_node == node and (
        selected_occurrence is None or selected_occurrence == invocation
    )

    capture = {
        "node": node,
        "providerInvocation": invocation,
        "scenario": scenario,
        "promptSha256": hashlib.sha256(prompt.encode()).hexdigest(),
    }
    input_match = re.search(
        r"Input JSON:\n([^\n]+)\nRuntime-owned response contract:", prompt
    )
    if input_match is not None:
        capture["input"] = json.loads(input_match.group(1))
    with (state / "driver.jsonl").open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(capture, sort_keys=True) + "\n")

    if selected_here and behavior == "crash":
        print(f"controlled crash at {node}", file=sys.stderr)
        return 70
    if selected_here and behavior == "hang":
        signal.signal(signal.SIGTERM, lambda _signum, _frame: sys.exit(0))
        signal.signal(signal.SIGINT, lambda _signum, _frame: sys.exit(0))
        while True:
            time.sleep(1)

    emit({"type": "thread.started", "thread_id": f"p1-{node}-{invocation}"})
    emit({"type": "turn.started"})
    if selected_here and behavior == "malformed":
        response: object = {"wrong": True}
    elif selected_here and behavior == "missing":
        response = {"signals": {}, "diagnostic": None}
    elif selected_here and behavior == "reviewer_claim":
        response = {
            "output": None,
            "signals": {"decision": "resolve_d1"},
            "diagnostic": None,
        }
    else:
        response = response_for(node, invocation, response_scenario)
    envelope = json.dumps({"response": response}, separators=(",", ":"))
    emit({"type": "item.completed", "item": {"type": "agent_message", "text": envelope}})
    emit({
        "type": "turn.completed",
        "usage": {"input_tokens": 1, "cached_input_tokens": 0, "output_tokens": 1},
    })
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
