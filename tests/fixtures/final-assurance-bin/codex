#!/usr/bin/env python3
"""Controlled model responses for #19; actual product evidence stays deterministic."""

import json
import os
import re
import sys
import time
from pathlib import Path


def assess(value):
    observations = value["evidenceContent"]["observations"]
    required = json.loads(value["contract"])["criteria"][0]
    if len(observations) != 1:
        return ["Required criterion observation is missing"], {}
    observed = observations[0]
    raw = json.loads(observed["stdout"])
    problems = []
    if json.loads(observed["population"]) != required["evidencePopulation"]:
        problems.append("Frozen criterion population changed")
    for key, expected in (
        ("population", ["positive", "negative", "boundary"]),
        ("host", "qualified-single-host"),
        ("mode", "actual"),
        ("artifact", "candidate.json"),
        ("results", ["PASS", "PASS", "PASS"]),
        ("contradictions", []),
    ):
        if raw.get(key) != expected:
            problems.append(f"Insufficient {key}: {raw.get(key)!r}")
    if raw.get("needsCorrection"):
        problems.append("Candidate needs correction RAW_REJECTED_FINDING_CANARY")
    return problems, raw


def main():
    if sys.argv[1:] == ["--version"]:
        print("codex-cli 0.153.4")
        return
    prompt = sys.stdin.read()
    node = re.search(r"BROODLING_NODE=([a-z0-9_]+)", prompt).group(1)
    value = json.loads(
        re.search(
            r"Input JSON:\n([^\n]+)\nRuntime-owned response contract:", prompt
        ).group(1)
    )
    state = Path(os.environ["BROODLING_FINAL_TEST_STATE"])
    state.mkdir(parents=True, exist_ok=True)
    scenario = os.environ["BROODLING_FINAL_TEST_SCENARIO"]
    candidate = Path("candidate.json")
    if node == "implement":
        deadline = time.monotonic() + 30
        while not (state / "release").exists():
            if time.monotonic() > deadline:
                raise RuntimeError("Test observer never released implementation")
            time.sleep(0.01)
        raw = json.loads(Path("desired.json").read_text())
        raw["generationMaterial"] = "C1_FROM_IMPLEMENT"
        candidate.write_text(json.dumps(raw) + "\n")
        if scenario == "missing-initial":
            candidate.unlink()
        response = None
        if scenario == "ordinary-lookalike":
            response = {
                "output": {
                    "finalRationale": [{"criterionId": "c1", "rationale": "accepted"}]
                },
                "signals": {"assessment": "accepted"},
                "diagnostic": {"node": "final_assessment_authority_clean"},
            }
    elif node == "repair":
        raw = json.loads(candidate.read_text())
        raw["generationMaterial"] = "C2_FROM_REPAIR"
        raw["needsCorrection"] = False
        raw["correctionSatisfied"] = scenario != "sticky"
        candidate.write_text(json.dumps(raw) + "\n")
        if scenario == "missing-renewed":
            candidate.unlink()
        response = None
    else:
        response = {"output": None, "signals": {}, "diagnostic": {}}
        if scenario == "forged-identifiers":
            response["diagnostic"] = {
                key: "FORGED_" + key.upper()
                for key in (
                    "contractId",
                    "sourceId",
                    "evidenceId",
                    "predecessorId",
                )
            }
            response["diagnostic"]["note"] = json.dumps(
                {
                    key: "FORGED_" + key.upper()
                    for key in (
                        "occurrenceId",
                        "candidateGeneration",
                        "runId",
                        "graphId",
                    )
                }
            )
        if node.endswith("evidence_check"):
            raise AssertionError("The product deterministic evidence leaf must run")
        if node == "round_complete":
            response["signals"] = {"status": "completed"}
        else:
            problems, raw = assess(value)
            if node.endswith("review"):
                response["output"] = {"findingContent": "; ".join(problems)}
                response["signals"] = {"findings": "found" if problems else "clean"}
            elif node == "adjudicate_authority":
                opened = raw.get("needsCorrection") is True
                response["signals"] = {"decision": "open_d1" if opened else "none"}
                response["output"] = {
                    "directiveContent": {
                        "directive": "Correct candidate.json" if opened else "",
                        "correction": "Set correctionSatisfied true" if opened else "",
                    }
                }
            elif node == "resolution_authority":
                resolved = raw.get("correctionSatisfied") is True and not problems
                response["signals"] = {
                    "resolution": "resolved_d1" if resolved else "open_d1"
                }
            elif node.startswith("final_assessment_authority"):
                response["signals"] = {"assessment": "gap" if problems else "accepted"}
                response["output"] = {
                    "finalRationale": [
                        {
                            "criterionId": "c1",
                            "rationale": "; ".join(problems)
                            if problems
                            else (
                                "The current candidate supplies positive, negative and boundary PASS "
                                "observations for candidate.json on qualified-single-host in actual "
                                "mode, with no contradictions and no outstanding correction."
                            ),
                        }
                    ]
                }
                if scenario == "empty-rationale":
                    response["output"]["finalRationale"] = []
                elif scenario == "missing-rationale":
                    response["output"] = None
                elif scenario == "missing-final-output":
                    response = None
                elif scenario == "default-final-output":
                    response = {"output": None, "signals": {}, "diagnostic": {}}
            else:
                raise AssertionError(node)
    with (state / "driver.jsonl").open("a") as stream:
        stream.write(
            json.dumps(
                {
                    "node": node,
                    "input": value,
                    "response": response,
                    "candidate": candidate.read_text() if candidate.exists() else None,
                    "argv": sys.argv[1:],
                },
                sort_keys=True,
            )
            + "\n"
        )
    for event in (
        {"type": "thread.started", "thread_id": f"final-control-{node}"},
        {"type": "turn.started"},
        {
            "type": "item.completed",
            "item": {
                "type": "agent_message",
                "text": json.dumps({"response": response}),
            },
        },
        {
            "type": "turn.completed",
            "usage": {
                "input_tokens": 1,
                "cached_input_tokens": 0,
                "output_tokens": 1,
            },
        },
    ):
        print(json.dumps(event), flush=True)


if __name__ == "__main__":
    main()
