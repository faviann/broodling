#!/usr/local/bin/python3
"""Controlled provider for the hosted target: each node's reply follows its response schema."""
import base64
import json
import subprocess
import sys
import time
import uuid
from pathlib import Path

arguments = sys.argv[1:]
if arguments == ["--version"]:
    print("2.1.276 (Claude Code)")
    raise SystemExit(0)
prompt = sys.stdin.read()
schema = json.loads(arguments[arguments.index("--json-schema") + 1])["properties"]["response"]


def value(field):
    if field["type"] == "null":
        return None
    if field["type"] == "string":
        return field["enum"][0] if "enum" in field else "Controlled fixture text"
    return {name: value(item) for name, item in field["properties"].items()}


node_input = json.loads(prompt.split("Input JSON:\n", 1)[1].split("\n", 1)[0]) if schema["type"] == "null" else {}
phase = node_input.get("phase", {}).get("after")
if phase in ("ci_failed", "conflict", "repair_required"):
    # Delivery repair: append exactly what delivery reported to the candidate, so every repair is a new
    # commit, and resolve and stage README.md, which a materialized merge conflict leaves unmerged.
    with open("delivery-repairs.jsonl", "a") as repairs:
        repairs.write(json.dumps({"outcome": phase, "deliveryFeedback": node_input["deliveryFeedback"]}) + "\n")
    Path("README.md").write_text("candidate repaired by the controlled provider\n")
    subprocess.run(["/usr/bin/git", "add", "--all"], check=True)
elif schema["type"] == "null":
    # Access qualification (#187): when the forge supplies the secrets' hashes, probe the private-control
    # boundary as this execution agent before doing anything else.
    if Path("/forge/probe/hashes.json").exists():
        subprocess.run(["/usr/local/bin/broodling-access-probe", "/forge/probe/hashes.json",
                        f"/forge/probe/result-{uuid.uuid4()}.json"], input=prompt.encode(), check=True)
    # While the forge holds /forge/hold the worker waits, so its run stays active until it is stopped.
    while Path("/forge/hold").exists():
        time.sleep(0.2)
    # The worker changes the checkout so delivery has a candidate commit.
    Path("README.md").write_text("candidate from the controlled provider\n")
    # Environment selection (#235): when the forge holds /forge/report-os, the candidate also records the OS
    # identity this agent observes.
    if Path("/forge/report-os").exists():
        Path("observed-os").write_text(next(line for line in Path("/etc/os-release").read_text().splitlines()
                                            if line.startswith("PRETTY_NAME=")) + "\n")
    # Like an agent consulting its available references, it writes each one's exact bytes as its frozen
    # task carries them, with no reader to call.
    task = node_input["task"]
    bundle = json.loads(task.split("\n\n", 1)[1]).get("requestBundle")
    for index, reference in enumerate(bundle["references"] if bundle else []):
        content = reference["content"]
        Path("references").mkdir(exist_ok=True)
        Path("references", str(index)).write_bytes(
            base64.b64decode(content) if reference["encoding"] == "base64" else content.encode())
# Native resumes a node's session by its ID and refuses a turn that reports another one.
session = arguments[arguments.index("--resume") + 1] if "--resume" in arguments else str(uuid.uuid4())
for event in (
    {"type": "system", "subtype": "init", "session_id": session},
    {"type": "result", "subtype": "success", "is_error": False, "session_id": session,
     "structured_output": {"response": value(schema)}, "usage": {"input_tokens": 1, "output_tokens": 1}},
):
    print(json.dumps(event), flush=True)
