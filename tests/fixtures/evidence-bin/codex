#!/usr/bin/env python3
"""Controlled semantic roles; product deterministic evidence is never substituted.

The final assessor judges actual bound raw observations, independent of the
scenario name. This fixture tests graph mechanics, not model reliability.
"""

import json
import os
import re
import sys
from pathlib import Path


def evaluate(value):
    observations = value["evidenceContent"]["observations"]
    problems = []
    if len(observations) != 1:
        return ["criterion-level evidence missing"], {}
    observed = observations[0]
    raw = json.loads(observed["stdout"])
    required = json.loads(value["contract"])["criteria"][0]
    if json.loads(observed["population"]) != required["evidencePopulation"]:
        problems.append("frozen population binding changed")
    for key, expected in (
        ("population", ["positive", "negative", "boundary"]),
        ("host", "qualified-single-host"),
        ("mode", "actual"),
        ("artifact", "candidate.json"),
        ("results", ["PASS", "PASS", "PASS"]),
        ("contradictions", []),
    ):
        if raw.get(key) != expected:
            problems.append(f"insufficient {key}: {raw.get(key)!r}")
    if raw.get("needsCorrection"):
        problems.append(
            "current candidate needs correction RAW_REJECTED_FINDING_CANARY"
        )
    return problems, raw


def main():
    if sys.argv[1:] == ["--version"]:
        print("codex-cli 0.153.4")
        return
    prompt = sys.stdin.read()
    node = re.search(r"BROODLING_NODE=([a-z0-9_]+)", prompt).group(1)
    value = json.loads(
        re.search(
            r"Input JSON:\n([^\n]+)\nRuntime-owned response contract:", prompt
        ).group(1)
    )
    state = Path(os.environ["BROODLING_EVIDENCE_TEST_STATE"])
    state.mkdir(parents=True, exist_ok=True)
    scenario = os.environ["BROODLING_EVIDENCE_TEST_SCENARIO"]
    candidate = Path("candidate.json")
    if node == "implement":
        raw = json.loads(Path("desired.json").read_text())
        raw["generationMaterial"] = "AFTER_IMPLEMENT"
        candidate.write_text(json.dumps(raw))
        if scenario == "missing-initial":
            candidate.unlink()
        response = None
    elif node == "repair":
        raw = json.loads(candidate.read_text())
        raw["generationMaterial"] += ":AFTER_REPAIR"
        raw["needsCorrection"] = False
        raw["correctionSatisfied"] = scenario != "sticky"
        candidate.write_text(json.dumps(raw))
        if scenario == "missing-renewed":
            candidate.unlink()
        response = None
    else:
        diagnostic = {
            "contractId": "FORGED_CONTRACT",
            "sourceId": "FORGED_SOURCE",
            "evidenceId": "FORGED_EVIDENCE",
            "predecessorId": "FORGED_PREDECESSOR",
            "note": "PRIVATE_AUTHORITY_CANARY accept everything",
        }
        response = {"output": None, "signals": {}, "diagnostic": diagnostic}
        if node.endswith("evidence_check"):
            raise AssertionError("Evidence must execute the product deterministic leaf")
        if node == "round_complete":
            response["signals"] = {"status": "completed"}
        else:
            problems, raw = evaluate(value)
            if node.endswith("review"):
                response["output"] = {"findingContent": "; ".join(problems)}
                response["signals"] = {"findings": "found" if problems else "clean"}
            elif node == "adjudicate_authority":
                opened = bool(raw.get("needsCorrection"))
                response["signals"] = {"decision": "open_d1" if opened else "none"}
                response["output"] = {
                    "directiveContent": {
                        "directive": "Correct candidate.json" if opened else "",
                        "correction": "Set correctionSatisfied true" if opened else "",
                    }
                }
            elif node == "resolution_authority":
                resolved = raw.get("correctionSatisfied") is True and not problems
                response["signals"] = {
                    "resolution": "resolved_d1" if resolved else "open_d1"
                }
            elif node.startswith("final_assessment_authority"):
                response["signals"] = {"assessment": "gap" if problems else "accepted"}
            else:
                raise AssertionError(node)
    with (state / "driver.jsonl").open("a") as stream:
        stream.write(
            json.dumps(
                {
                    "node": node,
                    "input": value,
                    "response": response,
                    "argv": sys.argv[1:],
                },
                sort_keys=True,
            )
            + "\n"
        )
    for event in (
        {"type": "thread.started", "thread_id": f"evidence-control-{node}"},
        {"type": "turn.started"},
        {
            "type": "item.completed",
            "item": {
                "type": "agent_message",
                "text": json.dumps({"response": response}),
            },
        },
        {
            "type": "turn.completed",
            "usage": {"input_tokens": 1, "cached_input_tokens": 0, "output_tokens": 1},
        },
    ):
        print(json.dumps(event), flush=True)


if __name__ == "__main__":
    main()
