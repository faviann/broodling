<?xml version="1.0" encoding="utf-8"?>
<!-- Zeroshot.Client comes from the SDK's GitHub Packages feed, which requires a package-read
     credential even for public packages. Supply it outside the repository, as the environment
     variable NuGetPackageSourceCredentials_github or in the user-level NuGet configuration;
     see tests/README.md. -->
<configuration>
  <packageSources>
    <clear />
    <add key="github" value="https://nuget.pkg.github.com/faviann/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Zeroshot.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
