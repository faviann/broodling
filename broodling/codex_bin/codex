#!/usr/bin/env python3
"""Apply Broodling's no-effect/context policy, then exec the configured CLI.

Zeroshot launches and owns this process; there is no process supervision here.
"""

import os
import sys

POLICY = {
    "sandbox_workspace_write.network_access": "false",
    "sandbox_workspace_write.exclude_slash_tmp": "true",
    "web_search": '"disabled"',
    "approval_policy": '"never"',
    # These capabilities can execute outside the command sandbox.
    "features.apps": "false",
    "features.plugins": "false",
    "features.hooks": "false",
    "notify": "[]",
}


def main() -> int:
    required = (
        "BROODLING_REAL_CODEX",
        "BROODLING_PROFILE_HOME",
        "BROODLING_ISOLATED_CODEX_HOME",
    )
    if any(not os.environ.get(name) for name in required):
        print("Broodling Codex profile paths are required", file=sys.stderr)
        return 78
    arguments = sys.argv[1:]
    if arguments and arguments[0] == "app-server":
        # Local configuration discovery is irrelevant to this explicit policy.
        # Zeroshot supports an unavailable probe and still owns the execution.
        print("Broodling supplies explicit execution policy", file=sys.stderr)
        return 78
    filtered = []
    sandbox = "workspace-write"
    index = 0
    while index < len(arguments):
        if arguments[index] in {
            "--dangerously-bypass-approvals-and-sandbox",
            "--full-auto",
            "--search",
        }:
            index += 1
            continue
        if arguments[index] == "--sandbox" and index + 1 < len(arguments):
            sandbox = arguments[index + 1]
            if sandbox not in {"read-only", "workspace-write"}:
                print("unsupported Codex sandbox policy", file=sys.stderr)
                return 78
            index += 2
            continue
        if (
            arguments[index] in {"--config", "-c"}
            and index + 1 < len(arguments)
            and arguments[index + 1].partition("=")[0] in {*POLICY, "sandbox_mode"}
        ):
            index += 2
            continue
        filtered.append(arguments[index])
        index += 1
    if filtered and filtered[0] == "exec":
        filtered[1:1] = [
            "--ignore-user-config",
            "--ignore-rules",
            *(
                arg
                for key, value in POLICY.items()
                for arg in ("--config", f"{key}={value}")
            ),
            "--sandbox",
            sandbox,
        ]
    environment = os.environ.copy()
    environment["HOME"] = environment["BROODLING_PROFILE_HOME"]
    environment["CODEX_HOME"] = environment["BROODLING_ISOLATED_CODEX_HOME"]
    executable = environment["BROODLING_REAL_CODEX"]
    os.execve(executable, [executable, *filtered], environment)


if __name__ == "__main__":
    raise SystemExit(main())
