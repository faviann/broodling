#!/usr/bin/env python3
"""Apply the qualified G1-V1/W4 profile to the sidecar's Codex invocation."""

import os
import runpy
import sys
from pathlib import Path


def main() -> int:
    required = (
        "BROODLING_REAL_CODEX",
        "BROODLING_PROFILE_HOME",
        "BROODLING_ISOLATED_CODEX_HOME",
    )
    if any(not os.environ.get(name) for name in required):
        print("Broodling qualified Codex profile paths are required", file=sys.stderr)
        return 78
    # This fixed flag is bound only to the two evidence occurrences by the
    # admitted runtime's declared connection. Prompt text never selects a role.
    if os.environ.get("BROODLING_EVIDENCE_LEAF"):
        leaf = Path(__file__).resolve().parents[1] / "mechanical_evidence.py"
        return runpy.run_path(str(leaf))["main"](sys.argv[1:])
    arguments = sys.argv[1:]
    filtered = []
    index = 0
    while index < len(arguments):
        if (
            arguments[index] in {"--config", "-c"}
            and index + 1 < len(arguments)
            and arguments[index + 1].startswith(
                "sandbox_workspace_write.network_access="
            )
        ):
            index += 2
            continue
        filtered.append(arguments[index])
        index += 1
    if filtered and filtered[0] == "exec":
        filtered[1:1] = [
            "--ignore-user-config",
            "--ignore-rules",
            "--ephemeral",
            "--config",
            "sandbox_workspace_write.network_access=false",
        ]
    environment = os.environ.copy()
    environment["HOME"] = environment["BROODLING_PROFILE_HOME"]
    environment["CODEX_HOME"] = environment["BROODLING_ISOLATED_CODEX_HOME"]
    executable = environment["BROODLING_REAL_CODEX"]
    os.execve(executable, [executable, *filtered], environment)
    return 78


if __name__ == "__main__":
    raise SystemExit(main())
