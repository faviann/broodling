<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- packages.lock.json records each package's content hash: restore refuses other bytes for the
         adopted Zeroshot.Client (tests/README.md#sdk-adoption). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="bridge/zeroshot_bridge.py;bridge/requirements.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="execution-assets/software-change-pr-codex-gateway.json;execution-assets/approval.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Zeroshot.Client" Version="[0.2.0-preview.1]" />
    <None Include="$(BaseIntermediateOutputPath)native/$(Configuration)/libbroodling_git.so"
          Link="libbroodling_git.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildAdministrativeGitShim" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)/native/git_spawn.c"
          Outputs="$(BaseIntermediateOutputPath)native/$(Configuration)/libbroodling_git.so">
    <MakeDir Directories="$(BaseIntermediateOutputPath)native/$(Configuration)" />
    <Exec Command="cc -std=c11 -O2 -fPIC -shared -Wall -Wextra -Werror &quot;$(MSBuildProjectDirectory)/native/git_spawn.c&quot; -o &quot;$(BaseIntermediateOutputPath)native/$(Configuration)/libbroodling_git.so&quot;" />
  </Target>

</Project>
