            ]
          },
          "effort": "medium",
          "kind": "agent",
          "model": "gpt-5.6-sol"
        },
        "worker": "builtin.agent.acceptance-verifier@1"
      },
      "code": {
        "kind": "verifier",
        "runtime": {
          "connections": {
            "gateway": [
              "GATEWAY_API_KEY",
              "GATEWAY_BASE_URL"
            ]
          },
          "effort": "medium",
          "kind": "agent",
          "model": "gpt-5.6-sol"
        },
        "worker": "builtin.agent.code-verifier@1"
      },
      "deliver": {
        "kind": "verifier",
        "runtime": {
          "connections": {
            "github": [
              "GH_TOKEN"
            ]
          },
          "kind": "git_delivery"
        },
        "worker": "builtin.git-delivery.pr@2"
      },
      "delivery_repair": {
        "kind": "step",
        "runtime": {
          "connections": {
