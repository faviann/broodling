              "GATEWAY_API_KEY",
              "GATEWAY_BASE_URL"
            ]
          },
          "effort": "medium",
          "kind": "agent",
          "model": "gpt-5.6-sol"
        },
        "worker": "builtin.agent.review-repair@1"
      },
      "worker": {
        "kind": "step",
        "runtime": {
          "connections": {
            "gateway": [
              "GATEWAY_API_KEY",
              "GATEWAY_BASE_URL"
            ]
          },
          "effort": "medium",
          "kind": "agent",
