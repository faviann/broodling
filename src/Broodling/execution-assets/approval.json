    }
  },
  "policy": {
    "workflow": "software-change",
    "delivery": "pull_request",
    "harness": "codex",
    "provider": "gateway",
    "model": "gpt-5.6-sol",
    "effort": "medium",
    "size": "small",
    "sessionScope": "execution",
    "connections": {
      "gateway": [
        "GATEWAY_API_KEY",
        "GATEWAY_BASE_URL"
      ],
      "github": [
        "GH_TOKEN"
      ]
    },
    "pullRequestFeedback": "consider",
    "gatewayBaseUrl": "https://cliproxy.local.faviann.com/v1"
  },
  "generation": {
    "recipe": "generate.sh",
    "recipeFiles": {
      "generate.sh": "e8da2580e06afa0dbda5cf37e9c1deba71db112fe46a57e237535be61df58ac8",
      "describe.py": "cce427fc7eb2cc8e9d1f27935d55d4d460abd179561e7af0b6f3b6c5aea303bf"
    },
    "recipeRevision": "ebab6f40be923dba37c26a33e00ce94cd7761a71",
    "environment": "env -i PATH=/usr/bin:/bin with an empty temporary HOME, ZEROSHOT_CONFIG_DIR and ZEROSHOT_STATE_DIR for each generation and the admission",
    "command": [
      "zeroshot",
      "profile",
      "set",
      "NAME",
      "--template",
      "software-change",
      "--delivery",
      "pull_request",
      "--uniform-runtime-config",
      "UNIFORM_RUNTIME_JSON"
    ],
    "uniformRuntime": {
      "harness": "codex",
      "provider": "gateway",
      "model": "gpt-5.6-sol",
      "effort": "medium",
      "size": "small",
      "sessionScope": "execution",
      "connections": {
        "gateway": [
          "GATEWAY_API_KEY",
          "GATEWAY_BASE_URL"
        ]
      }
    },
    "format": "{graph, runtime} from `zeroshot profile show NAME`, Python json.dumps(indent=2, sort_keys=True) plus a final newline"
  },
  "structure": {
    "delivery": {
      "node": "deliver",
      "pullRequestFeedback": "consider",
      "receipt": {
        "headRevision": {
          "required": true,
          "type": "string"
        },
        "mode": {
          "required": true,
          "type": [
            "pr"
          ]
        },
        "outcome": {
          "required": true,
          "type": [
            "ci_failed",
            "conflict",
            "ready",
            "repair_required"
          ]
        },
        "pullRequestId": {
          "required": true,
          "type": "string"
        },
        "repository": {
          "required": true,
          "type": "string"
        },
        "targetBranch": {
          "required": true,
          "type": "string"
        },
        "version": {
          "required": true,
          "type": [
            "v2"
          ]
        }
      },
      "signalRoutes": {
